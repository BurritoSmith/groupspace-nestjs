# Copy to .env and fill in. .env is gitignored — secrets never enter a commit.
#
# Only DATABASE_URL and SESSION_JWT_SECRET are needed to start. Everything else degrades: the
# service logs what it is disabling and carries on, rather than refusing to boot over a feature you
# are not working on.

# The embedded cluster from `npm run db:local`. Port 55432, not 5432, so it cannot collide with a
# Postgres already installed on this machine — point this at that one instead if you have it.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/converge"

PORT=3001
FRONTEND_ORIGIN="http://localhost:4200"

# Load-bearing: room.module.ts refuses to start without it rather than sign session tokens with a
# guessable default. Any random string; it only has to be stable for this checkout.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET=""

# Web push. Generate a pair per machine — a browser subscription made against this backend is only
# ever valid for this backend, so these are unrelated to the deployed keys.
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@localhost"

# Optional. Without it FcmService logs that native push is disabled and everything else runs, which
# is the right default locally — sending real pushes to real devices from a dev machine rarely is.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ffmpeg is a RUNTIME dependency, apt-installed in the Dockerfile alongside libheif-examples. A
# machine without it fails in two places that do not look related: RecordingService cannot start a
# recording, and VideoThumbnailService cannot produce the poster frames the album stack renders — so
# album thumbnails come out wrong. Both are a missing binary, not a code error.
#
# If ffmpeg is on PATH, leave this unset. If it is not and you cannot install one (no Homebrew, no
# admin), `npm i -D ffmpeg-static` ships a binary and this points at it:
#   node -e "console.log(require('ffmpeg-static'))"
# FFMPEG_PATH=

# HEIC uploads from an iPhone go through heif-convert (libheif-examples), NOT ffmpeg — bookworm's
# ffmpeg is 5.1 and the HEIF demuxer landed in 7.1, so a static ffmpeg does not cover this. Without
# it HEIC photos fail to transcode; everything else is unaffected.
# HEIF_CONVERT_PATH=

# Both default to cwd()/recordings and cwd()/chat-media. Set them if you want the files somewhere
# other than inside the checkout. Both paths are gitignored.
# RECORDINGS_DIR=
# CHAT_MEDIA_DIR=
