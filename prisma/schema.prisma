generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  googleSub   String   @unique
  email       String
  displayName String
  pictureUrl  String
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt // bumped automatically by Prisma on every update()/upsert()-update

  chatMessages  ChatMessage[]
  chatReactions ChatMessageReaction[]
  recordings    Recording[]
  settings      UserSetting[]
}

// Generic per-user preference storage — every user setting (starting with the microphone
// threshold) lives here as one row, keyed by an app-defined `key` string plus an optional
// `deviceId` for hardware-scoped settings. New settings need no schema change, just a new key.
model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  // Defaults to "" (not nullable) rather than allowing null — Postgres treats multiple NULLs as
  // distinct within a unique index, which would silently break the @@unique guarantee below for
  // a future non-device-scoped setting (deviceId "not applicable").
  deviceId  String   @default("")
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key, deviceId])
  @@index([userId])
}

model Room {
  name      String   @id // rooms have no separate UUID anywhere in this app — the name IS the identifier
  createdAt DateTime @default(now())

  chatMessages      ChatMessage[]
  recordings        Recording[]
  recordingSessions RecordingSession[]
}

// Groups every stream (webcam/screen/audio-mix) produced by one "start recording" ->
// "stop recording" action, so a future playback component can look up "all streams
// belonging to this session" and sync them together. `name` starts as the failsafe
// default (set at start()) and is overwritten with a user-chosen name if the deliberate
// stop-recording dialog flow supplies one — see RecordingService.start()/stop().
model RecordingSession {
  id        String    @id @default(uuid())
  roomName  String
  room      Room      @relation(fields: [roomName], references: [name])
  name      String
  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  recordings Recording[]
  events     RecordingEvent[]

  @@index([roomName, startedAt])
}

// A timestamped occurrence during an active recording — currently just participant join/leave
// (screen-share start/stop needs no row here at all; it's synthesized on read from Recording's
// own streamType: 'screen' rows, which already have their own startedAt/stoppedAt). Only ever
// written while a recording is actually running for the room — see RoomGateway's onJoinRoom/
// cleanupPeer, gated on RecordingService.isRecording().
model RecordingEvent {
  id          String           @id @default(uuid())
  sessionId   String
  session     RecordingSession @relation(fields: [sessionId], references: [id])
  type        String // 'join' | 'leave' — plain String, matching streamType/thumbnailStatus's own convention
  peerId      String
  userId      String?
  displayName String // snapshot at event time, same rationale as Recording.displayName
  at          DateTime         @default(now())

  @@index([sessionId, at])
}

model ChatMessage {
  id          String   @id @default(uuid()) // overridden with an app-generated UUID at insert time
  roomName    String
  room        Room     @relation(fields: [roomName], references: [name])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  displayName String // snapshot at send-time — a later Google account rename must not rewrite history
  pictureUrl  String? // snapshot at send-time, same reasoning as displayName — also lets a message from a
  // peer who has since left the room still show their avatar, instead of only ever resolving it through the
  // live presence roster. Nullable: a Google account with no profile photo genuinely has nothing to snapshot;
  // the frontend falls back to a generic person icon either way.
  text        String
  sentAt      DateTime @default(now())
  attachments Json? // IChatAttachment[] — image/video/gif metadata (url, kind, dimensions, ...). Null/absent
  // for a plain text message. See ChatMediaService/room.gateway.ts's isAllowedAttachmentUrl for how the
  // URLs inside are validated before a message is ever broadcast or persisted.
  linkPreview Json? // ILinkPreview | null — set asynchronously after the message is already broadcast (link
  // scraping is too slow to sit on the send path), via ChatService.updateLinkPreview + a follow-up
  // 'chat-message-updated' socket event. Absent on the vast majority of rows (most messages have no URL).

  reactions ChatMessageReaction[]

  @@index([roomName, sentAt]) // "most recent N in a room" is the only history query needed
  @@index([userId])
}

// One person's one emoji on one message. A real table rather than another Json column on
// ChatMessage (which is how attachments/linkPreview are stored) specifically for the @@unique
// below: toggling has to be correct when the same person double-taps, and two clients can be
// mid-toggle on the same message at once. A Json array can't express that constraint, so the
// de-duplication would have to live in application code racing itself.
//
// Stacking is allowed: one user can hold several different emoji on the same message, so the
// unique key includes `emoji` rather than stopping at (messageId, userId).
model ChatMessageReaction {
  id          String      @id @default(uuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  displayName String // snapshot at react-time, same reasoning as ChatMessage.displayName — it also
  // means the "who reacted" list still resolves for someone who has since left the room, with no join.
  emoji       String
  createdAt   DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId]) // "every reaction on this message", which is the only read there is
}

model Recording {
  id           String           @id @default(uuid())
  roomName     String
  room         Room             @relation(fields: [roomName], references: [name])
  sessionId    String
  session      RecordingSession @relation(fields: [sessionId], references: [id])
  userId       String? // nullable — the combined-audio-mix row has no single owning participant
  user         User?            @relation(fields: [userId], references: [id])
  displayName  String // snapshot; literal 'mixed-audio' for the audio-mix row
  streamType   String // 'webcam' | 'screen' | 'audio' — plain String, not a Prisma enum: RecordingService
  // already treats these as plain string literals, an enum would add migration overhead for no benefit here.
  streamNumber Int
  filename     String
  gcsPath      String? // <roomName>/<sessionName>/<filename> in RECORDINGS_GCS_BUCKET, when configured
  // (production/GCP only — local dev keeps writing to disk and leaves this null). Set to the deterministic
  // intended path regardless of upload success — see gcsUploadedAt for whether it's actually there yet.
  gcsUploadedAt DateTime? // null until the GCS upload actually succeeds. Distinguishes "gcsPath is the intended
  // path" from "confirmed present in the bucket" — playback serves the local VM file until this is set, then
  // hands off to the signed GCS URL. Stays null forever in local dev (no bucket configured).
  thumbnailStatus    String? // 'live' | 'final' — plain String, matching streamType's own convention over a
  // Prisma enum for a small state machine. Null = no thumbnail yet (mid-recording, before the first extraction
  // attempt, or extraction failed), or permanently null for streamType 'audio' (no thumbnail concept).
  thumbnailUpdatedAt DateTime? // set every time the thumbnail file is (re)written. Doubles as the cache-busting
  // query param on the thumbnail URL (the derived filename is identical across the grayscale->color swap).
  startedAt    DateTime         @default(now())
  stoppedAt    DateTime? // null until finalizeVideoSession/finalizeAudioMix runs
  hasContent   Boolean          @default(true) // false when remux found the temp recording missing/empty or
  // itself failed — i.e. the producer never emitted a keyframe (a separate, already-diagnosed browser/encoder
  // issue) or the stream was stopped before any data was captured. stoppedAt is still set either way (it did
  // stop), but a false here means there's no real file at the URL buildPlaybackUrls would otherwise construct —
  // playback must never link to it, and PlaybackSync must exclude it from the shared timeline entirely.

  @@index([roomName, startedAt])
  @@index([userId])
  @@index([sessionId])
}
