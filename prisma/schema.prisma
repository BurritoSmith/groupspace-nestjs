generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  // Null for a guest — someone admitted to a private room by passcode rather than by signing in.
  // Nullable rather than a second identity table because the alternative is a polymorphic foreign
  // key threaded through RoomMember, ChatMessage, ChatMessageReaction and every audit row; one
  // nullable column is cheaper than that everywhere. Postgres treats multiple NULLs as distinct
  // within a unique index, so any number of guests coexist under the @unique below.
  googleSub      String?  @unique
  // Null for a guest too: a passcode join collects a display name and nothing else. Anything that
  // emails a user must therefore check for null rather than assuming an address exists.
  email          String?
  // 'google' | 'guest'. Denormalized from "is googleSub null" so a guard can answer "is this a
  // verified identity" without a join, and so the session JWT can carry it — see the capability
  // resolver, which refuses guests the sensitive capabilities (notably iep:view-executed, which
  // must not be reachable by whoever happened to have the room passcode).
  authKind       String   @default("google")
  displayName    String
  pictureUrl     String
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @updatedAt // bumped automatically by Prisma on every update()/upsert()-update
  invitationCode String? // whichever code got them through the gate — set once at creation only
  // (UsersService.upsertFromGoogleProfile never touches it on an update), so it's a permanent
  // record of how someone originally got in, not something a later re-invite would overwrite.

  chatMessages       ChatMessage[]
  chatReactions      ChatMessageReaction[]
  recordings         Recording[]
  settings           UserSetting[]
  roomMemberships    RoomMember[]
  pushSubscriptions  PushSubscription[]
  fcmTokens          FcmToken[]
  createdRooms       Room[]                 @relation("RoomCreator")
  moduleRoles        RoomMemberModuleRole[]
  invitationsSent    RoomInvitation[]       @relation("RoomInvitationInviter")
  invitationsClaimed RoomInvitation[]       @relation("RoomInvitationAcceptor")
}

// Generic per-user preference storage — every user setting (starting with the microphone
// threshold) lives here as one row, keyed by an app-defined `key` string plus an optional
// `deviceId` for hardware-scoped settings. New settings need no schema change, just a new key.
model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  // Defaults to "" (not nullable) rather than allowing null — Postgres treats multiple NULLs as
  // distinct within a unique index, which would silently break the @@unique guarantee below for
  // a future non-device-scoped setting (deviceId "not applicable").
  deviceId  String   @default("")
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key, deviceId])
  @@index([userId])
}

// The invitation-code gate the frontend shows before anyone reaches Google sign-in — a row here
// (added/removed directly via DBeaver, not an admin UI) is what "invited" means. Matched
// case-insensitively (see InvitationsService), so storage case doesn't matter.
model Invitation {
  id        String   @id @default(uuid())
  code      String   @unique
  createdAt DateTime @default(now())
}

model Room {
  name            String   @id // rooms have no separate UUID anywhere in this app — the name IS the identifier
  createdAt       DateTime @default(now())
  // Nullable only because every room predating explicit creation has no recorded creator. The
  // migration backfills it from the earliest member, but a room whose members were all deleted has
  // no honest answer, and inventing one would be worse than admitting it. Always set going forward:
  // RoomService.create is now the only thing that makes a Room row.
  createdByUserId String?
  createdBy       User?    @relation("RoomCreator", fields: [createdByUserId], references: [id])
  // 'public' | 'private'. Public is what every room was before this existed, and is what the
  // backfill assigns, so nothing that worked stops working. Private rooms admit a member only by
  // RoomInvitation or by passcode.
  //
  // Not purely the owner's choice: a module may declare requiresPrivate, and enabling one that does
  // forces this to 'private' and refuses to let it back to 'public' while that module is enabled —
  // see RoomService. That is how "an IEP room is private" is enforced rather than merely expected.
  visibility      String   @default("public")
  // Argon2/bcrypt digest, never the passcode itself and never returned to a client. Null means the
  // room has no passcode, which for a private room means invitation is the only way in.
  passcodeHash    String?

  chatMessages      ChatMessage[]
  recordings        Recording[]
  recordingSessions RecordingSession[]
  members           RoomMember[]
  modules           RoomModule[]
  invitations       RoomInvitation[]
  moduleRoles       RoomMemberModuleRole[]
}

// Scaffolding for a lightweight, permission-free "has this user ever been in this room" concept —
// seeded for pre-existing rooms by backfilling distinct (userId, roomName) pairs out of ChatMessage
// history (see the migration SQL). Drives two things for now: the join-room screen's "rooms you've
// visited before" typeahead, and push-notification eligibility (RecordingService/PushNotification
// only ever notify a room's members, never a stranger who's never been in it). The permissions this
// was left room for now exist — see `role` below.
model RoomMember {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  roomName      String
  room          Room     @relation(fields: [roomName], references: [name])
  firstJoinedAt DateTime @default(now())
  lastJoinedAt  DateTime @updatedAt
  // 'owner' | 'moderator' | 'member' | 'guest' — GOVERNANCE only: what you may do to the ROOM.
  // Deliberately a small fixed set that knows nothing about any module, so that adding a module
  // never widens it. Who you are within a module's process is a different question with a different
  // answer, stored in RoomMemberModuleRole.
  //
  // Defaults to 'member', which is also what the backfill gives everyone except the earliest member
  // of each existing room, who becomes its 'owner'.
  role          String   @default("member")

  @@unique([userId, roomName])
  @@index([userId])
  @@index([roomName])
}

// Which modules a room has switched on. A table rather than a JSON column on Room so that "every
// room with the IEP module enabled" is a query rather than a scan, and so each module owns its own
// config blob without any two of them sharing a document.
//
// chat/live/playback are listed here too, but only as DATA: the room records that they are on and
// the create step toggles them, while their code stays where it is and reads a flag. Actually
// rehoming them into the module system is a separate piece of work, and doing it here would have
// swamped this one.
model RoomModule {
  id        String   @id @default(uuid())
  roomName  String
  room      Room     @relation(fields: [roomName], references: [name])
  // Matches the id in the frontend module registry: 'chat' | 'live' | 'playback' | 'iep'.
  moduleId  String
  config    Json     @default("{}")
  enabledAt DateTime @default(now())

  @@unique([roomName, moduleId])
  @@index([moduleId])
}

// Who you are inside one module's process, as opposed to what you may do to the room.
//
// `role` is a plain string whose vocabulary belongs to the module and is validated by it — IEP uses
// 'administrator' | 'parent' | 'student' | 'instructor' | 'observer'. Keeping it open is what lets a
// new module ship without touching this schema at all: it adds rows, never columns or enum values.
// It is also what lets the person who created the room not be the IEP administrator, which is the
// normal case and cannot be expressed with a single role per member.
model RoomMemberModuleRole {
  id       String @id @default(uuid())
  roomName String
  room     Room   @relation(fields: [roomName], references: [name])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  moduleId String
  role     String

  assignedAt DateTime @default(now())

  // One role per person per module. Someone needing two roles in one process (a parent who is also
  // an instructor at the same school, say) is a real situation, but it wants deliberate handling in
  // the module rather than two rows that every capability check would have to reconcile.
  @@unique([roomName, userId, moduleId])
  @@index([roomName, moduleId])
  @@index([userId])
}

// An invitation into one room, carrying the roles the invitee will hold when they accept.
//
// NOT to be confused with `Invitation` above, which is the global app-signup gate — a code that
// gets you an account at all. This is per-room and per-person. The two were nearly given the same
// name, and anything that conflates them will hand out the wrong kind of access.
//
// Roles ride along on the invitation because an IEP meeting is convened before anyone joins: the
// administrator knows the parent's address and what they are to the process days ahead, and a
// meeting that opens with everyone unroled while the facilitator does admin is a worse meeting.
model RoomInvitation {
  id               String    @id @default(uuid())
  roomName         String
  room             Room      @relation(fields: [roomName], references: [name])
  // Matched case-insensitively against the VERIFIED email in the Google ID token, and only when
  // that token says email_verified. Bound to a userId on first accept and matched by id from then
  // on — a Workspace address can be reassigned to a different person, and an invitation that stayed
  // keyed on the string would follow the address rather than the human.
  email            String
  roomRole         String    @default("member")
  // { moduleId: role } for every module the invitee has a part in, applied atomically on accept.
  moduleRoles      Json      @default("{}")
  // Unguessable, single-use, and the only thing the invitation link carries. Hashing it would be
  // better still; it is stored plain here because it is short-lived and revocable, and the room it
  // opens is itself access-controlled — revisit if invitations ever become long-lived.
  token            String    @unique
  invitedByUserId  String
  invitedBy        User      @relation("RoomInvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedByUserId String?
  acceptedBy       User?     @relation("RoomInvitationAcceptor", fields: [acceptedByUserId], references: [id])
  acceptedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([roomName])
  @@index([email])
}

// One registered Web Push endpoint for one browser/device install. `deviceId` is client-minted
// (crypto.randomUUID(), persisted in localStorage) rather than derived from the endpoint itself,
// so re-subscribing the same install (e.g. after the push service rotates its endpoint under the
// hood) upserts in place instead of accumulating duplicate rows.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String
  endpoint  String
  p256dh    String
  auth      String
  // Which OS the SUBSCRIBING BROWSER runs on — 'android' | 'ios' | 'desktop', or 'web' meaning
  // "unknown", which is what every row predating this column holds. It exists purely so a native
  // app can suppress the duplicate: PushNotificationService skips any subscription whose platform
  // matches one this user has a live FcmToken for, so installing the Android app silences that
  // phone's browser push without touching the same user's desktop browser. 'web' is never matched
  // by anything, so an un-backfilled row keeps working exactly as before — the client re-registers
  // on boot, which is what upgrades it in place.
  platform  String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

// One registered FCM token per (userId, deviceId) — a separate table from PushSubscription rather
// than an overload of it, since the shapes don't overlap (a single opaque token vs. an
// endpoint/p256dh/auth triplet). Same deviceId convention, so dismissOtherDevices' "which device is
// active" logic works the same way across both tables. Nothing writes to this yet: it exists ahead
// of a Capacitor mobile app (Android push is FCM-only) and an Electron path that turned out not to
// need it — see push-notification.service.ts.
model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String
  token     String
  platform  String // 'android' | 'ios' once a mobile app exists to set them
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

// Groups every stream (webcam/screen/audio-mix) produced by one "start recording" ->
// "stop recording" action, so a future playback component can look up "all streams
// belonging to this session" and sync them together. `name` starts as the failsafe
// default (set at start()) and is overwritten with a user-chosen name if the deliberate
// stop-recording dialog flow supplies one — see RecordingService.start()/stop().
model RecordingSession {
  id        String    @id @default(uuid())
  roomName  String
  room      Room      @relation(fields: [roomName], references: [name])
  name      String
  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  recordings Recording[]
  events     RecordingEvent[]

  @@index([roomName, startedAt])
}

// A timestamped occurrence during an active recording — currently just participant join/leave
// (screen-share start/stop needs no row here at all; it's synthesized on read from Recording's
// own streamType: 'screen' rows, which already have their own startedAt/stoppedAt). Only ever
// written while a recording is actually running for the room — see RoomGateway's onJoinRoom/
// cleanupPeer, gated on RecordingService.isRecording().
model RecordingEvent {
  id          String           @id @default(uuid())
  sessionId   String
  session     RecordingSession @relation(fields: [sessionId], references: [id])
  type        String // 'join' | 'leave' — plain String, matching streamType/thumbnailStatus's own convention
  peerId      String
  userId      String?
  displayName String // snapshot at event time, same rationale as Recording.displayName
  at          DateTime         @default(now())

  @@index([sessionId, at])
}

model ChatMessage {
  id          String   @id @default(uuid()) // overridden with an app-generated UUID at insert time
  roomName    String
  room        Room     @relation(fields: [roomName], references: [name])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  displayName String // snapshot at send-time — a later Google account rename must not rewrite history
  pictureUrl  String? // snapshot at send-time, same reasoning as displayName — also lets a message from a
  // peer who has since left the room still show their avatar, instead of only ever resolving it through the
  // live presence roster. Nullable: a Google account with no profile photo genuinely has nothing to snapshot;
  // the frontend falls back to a generic person icon either way.
  text        String
  sentAt      DateTime @default(now())
  attachments Json? // IChatAttachment[] — image/video/gif metadata (url, kind, dimensions, ...). Null/absent
  // for a plain text message. See ChatMediaService/room.gateway.ts's isAllowedAttachmentUrl for how the
  // URLs inside are validated before a message is ever broadcast or persisted.
  linkPreview Json? // ILinkPreview | null — set asynchronously after the message is already broadcast (link
  // scraping is too slow to sit on the send path), via ChatService.updateLinkPreview + a follow-up
  // 'chat-message-updated' socket event. Absent on the vast majority of rows (most messages have no URL).
  deleted     Boolean  @default(false) // soft delete — the row stays for history, the sender's own
  // ChatService.softDelete flips this via 'chat-message-delete', and the frontend renders a
  // placeholder in place of the real content wherever it's true (live, scrollback, and rejoin alike).

  reactions ChatMessageReaction[]

  @@index([roomName, sentAt]) // "most recent N in a room" is the only history query needed
  @@index([userId])
}

// One person's one emoji on one message. A real table rather than another Json column on
// ChatMessage (which is how attachments/linkPreview are stored) specifically for the @@unique
// below: toggling has to be correct when the same person double-taps, and two clients can be
// mid-toggle on the same message at once. A Json array can't express that constraint, so the
// de-duplication would have to live in application code racing itself.
//
// Stacking is allowed: one user can hold several different emoji on the same message, so the
// unique key includes `emoji` rather than stopping at (messageId, userId).
model ChatMessageReaction {
  id          String      @id @default(uuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  displayName String // snapshot at react-time, same reasoning as ChatMessage.displayName — it also
  // means the "who reacted" list still resolves for someone who has since left the room, with no join.
  emoji       String
  createdAt   DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId]) // "every reaction on this message", which is the only read there is
}

model Recording {
  id                 String           @id @default(uuid())
  roomName           String
  room               Room             @relation(fields: [roomName], references: [name])
  sessionId          String
  session            RecordingSession @relation(fields: [sessionId], references: [id])
  userId             String? // nullable — the combined-audio-mix row has no single owning participant
  user               User?            @relation(fields: [userId], references: [id])
  displayName        String // snapshot; literal 'mixed-audio' for the audio-mix row
  streamType         String // 'webcam' | 'screen' | 'mic' | 'camera' — plain String, not a Prisma enum: RecordingService
  // already treats these as plain string literals, an enum would add migration overhead for no benefit here.
  // 'camera' is a single file combining one participant's mic AND webcam (see
  // RecordingService.startCombinedCameraSession) — used instead of separate 'mic'/'webcam' rows
  // whenever both are already active together, for frame-accurate native A/V sync at playback.
  streamNumber       Int
  filename           String
  gcsPath            String? // <roomName>/<sessionName>/<filename> in RECORDINGS_GCS_BUCKET, when configured
  // (production/GCP only — local dev keeps writing to disk and leaves this null). Set to the deterministic
  // intended path regardless of upload success — see gcsUploadedAt for whether it's actually there yet.
  gcsUploadedAt      DateTime? // null until the GCS upload actually succeeds. Distinguishes "gcsPath is the intended
  // path" from "confirmed present in the bucket" — playback serves the local VM file until this is set, then
  // hands off to the signed GCS URL. Stays null forever in local dev (no bucket configured).
  thumbnailStatus    String? // 'live' | 'final' — plain String, matching streamType's own convention over a
  // Prisma enum for a small state machine. Null = no thumbnail yet (mid-recording, before the first extraction
  // attempt, or extraction failed), or permanently null for streamType 'mic' (no thumbnail concept).
  thumbnailUpdatedAt DateTime? // set every time the thumbnail file is (re)written. Doubles as the cache-busting
  // query param on the thumbnail URL (the derived filename is identical across the grayscale->color swap).
  startedAt          DateTime         @default(now())
  stoppedAt          DateTime? // null until finalizeVideoSession/finalizeAudioMix runs
  hasContent         Boolean          @default(true) // false when remux found the temp recording missing/empty or
  // itself failed — i.e. the producer never emitted a keyframe (a separate, already-diagnosed browser/encoder
  // issue) or the stream was stopped before any data was captured. stoppedAt is still set either way (it did
  // stop), but a false here means there's no real file at the URL buildPlaybackUrls would otherwise construct —
  // playback must never link to it, and PlaybackSync must exclude it from the shared timeline entirely.

  @@index([roomName, startedAt])
  @@index([userId])
  @@index([sessionId])
}
