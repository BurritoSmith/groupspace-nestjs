# Copy this to .env on the VM and fill in real values — .env itself is gitignored
# and must never be committed (it holds TURN_SECRET).

# The VM's reserved static external IP (from: gcloud compute addresses describe spaces-vm-ip ...)
VM_PUBLIC_IP=

# Dashes, not dots, e.g. 34.123.45.67 -> 34-123-45-67.sslip.io
SSLIP_HOSTNAME=

# Generate with: openssl rand -base64 32
TURN_SECRET=

# Raw IP, not the sslip.io hostname — turn: has no TLS/SNI, so a hostname buys nothing.
TURN_HOST=
TURN_PORT=3478

# The deployed App Engine frontend URL, e.g. https://your-project.appspot.com
# Leave blank for the very first deploy; filled in after the first `gcloud app deploy`.
FRONTEND_ORIGIN=

PORT=3001
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40199

# Recording (loopback-only RTP forwarding to ffmpeg — no firewall rule needed for this range)
RECORDINGS_DIR=/recordings
RECORDING_PORT_MIN=45000
RECORDING_PORT_MAX=45199
# Optional: only needed if "ffmpeg" isn't resolvable via PATH (e.g. some local dev setups).
# Leave blank in production — ffmpeg is on PATH in the Docker image.
FFMPEG_PATH=
