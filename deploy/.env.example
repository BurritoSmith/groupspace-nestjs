# Copy this to .env on the VM and fill in real values — .env itself is gitignored
# and must never be committed (it holds TURN_SECRET).

# The VM's reserved static external IP (from: gcloud compute addresses describe spaces-vm-ip ...)
VM_PUBLIC_IP=

# Dashes, not dots, e.g. 34.123.45.67 -> 34-123-45-67.sslip.io
SSLIP_HOSTNAME=

# Generate with: openssl rand -base64 32
TURN_SECRET=

# Signs the app's own long-lived session tokens (separate from Google sign-in — see
# SessionService) so users don't have to re-sign-in with Google every ~1hr. Generate with:
# openssl rand -base64 32
SESSION_JWT_SECRET=

# Raw IP, not the sslip.io hostname — turn: has no TLS/SNI, so a hostname buys nothing.
TURN_HOST=
TURN_PORT=3478

# The deployed App Engine frontend URL, e.g. https://your-project.appspot.com
# Leave blank for the very first deploy; filled in after the first `gcloud app deploy`.
FRONTEND_ORIGIN=

PORT=3001
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40199

# Recording (loopback-only RTP forwarding to ffmpeg — no firewall rule needed for this range)
RECORDINGS_DIR=/recordings
RECORDING_PORT_MIN=45000
RECORDING_PORT_MAX=45199
# Optional: only needed if "ffmpeg" isn't resolvable via PATH (e.g. some local dev setups).
# Leave blank in production — ffmpeg is on PATH in the Docker image.
FFMPEG_PATH=

# Database (self-hosted Postgres, network_mode: host — reachable at 127.0.0.1:5432 from
# the app container. Do NOT open a GCE firewall rule for 5432 — every service here uses
# network_mode: host, so Postgres binds to the host's network stack, but the VM firewall
# already default-denies inbound traffic unless a rule explicitly allows it; adding one
# for 5432 would expose Postgres to the public internet.)
# Generate POSTGRES_PASSWORD with: openssl rand -base64 24
POSTGRES_USER=spaces
POSTGRES_PASSWORD=
POSTGRES_DB=spaces
# env_file loading does NOT expand ${...} referencing other vars in this same file —
# DATABASE_URL must be written out in full, kept in sync with the values above manually.
DATABASE_URL=postgresql://spaces:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5432/spaces?schema=public

# Cloud Storage bucket for finished recordings — <roomName>/<sessionName>/<filename>.
# The VM's default Compute Engine service account needs Storage object write access (already
# has it here via Project Editor -> legacyBucketOwner on the bucket) and
# roles/iam.serviceAccountTokenCreator on ITSELF (for signing playback URLs without a key file).
# Leave blank in local dev — recordings just stay under RECORDINGS_DIR, same as always.
RECORDINGS_GCS_BUCKET=groupspace-tv-recordings-development

# Cloud Storage bucket for chat image/video/gif attachments — <roomName>/<yyyy>/<mm>/<uuid>.<ext>.
# An existing bucket, reused rather than created fresh for this feature; uniform bucket-level
# access was already on. Unlike recordings, this bucket is PUBLIC-READ (allUsers:
# roles/storage.objectViewer, granted 2026-07-30) rather than served via signed URLs — see
# ChatMediaService's own comment for why. Leave blank in local dev — attachments stay under
# CHAT_MEDIA_DIR instead.
CHAT_MEDIA_GCS_BUCKET=groupspace-tv-file-upload-development

# Chat media size caps, in bytes — enforced server-side (chat-media.controller.ts /
# chat-media.service.ts) regardless of any client-side compression. Leave blank to use the
# built-in defaults (15 MB images, 100 MB video).
CHAT_MEDIA_MAX_IMAGE_BYTES=
CHAT_MEDIA_MAX_VIDEO_BYTES=

# Web Push (PushNotificationService) — the public key is also served unauthenticated at
# GET /push/vapid-public-key so the frontend never needs a rebuild to pick up a rotated key.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
